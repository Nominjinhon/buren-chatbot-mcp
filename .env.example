DATABASE_URL=postgresql+psycopg://buren:buren@host.docker.internal:5432/buren_chatbot
MODEL=gemini-3.6-flash
MODEL_API_KEY=
MCP_SERVER_PATH=

# Optional: exposes the MCP server over HTTP at /mcp (e.g. for a ChatGPT
# connector) instead of only the internal stdio subprocess. Leave blank to
# keep /mcp unmounted entirely.
MCP_HTTP_TOKEN=

# Optional: LangSmith tracing (https://smith.langchain.com/). Leave blank to disable.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
